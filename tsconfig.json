{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "allowJs": true,
        "types": [
            "astro/client",
            "node"
        ],
        "paths": {
            "@layouts/*": [
                "./src/layouts/*"
            ],
            "@components/*": [
                "./src/components/*"
            ],
            "@css/*": [
                "./src/css/*"
            ],
            "@js/*": [
                "./src/js/*"
            ],
            "@images/*": [
                "./src/assets/img/*"
            ],
            "@fonts/*": [
                "./src/assets/fonts/*"
            ],
            "@node/*": [
                "./node_modules/*"
            ]
        },
        "jsx": "react-jsx",
        "jsxImportSource": "react"
    }
}
