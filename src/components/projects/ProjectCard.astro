---
import { Image } from "astro:assets"
import { truncateWords } from '@shahid19/stringjs'

import NerdFontIcon from '@components/NerdFontIcon.astro'

const { icon = '' } = Astro.props
const { ...data } = Astro.props.project

const { title, slug, preview, screenshots } = data.data

/* BUG: for some reason one of the projects is returning
*  an undefined set of screenshots. I think overloading 
*  my homelab with too many requests will stall out strapi
*/
if(screenshots[0] == undefined) {
    return
}

const previewImage = screenshots
    .sort((a: any, b: any) => (a.width < b.width) ? 1 : -1)
    .slice(0,1)[0]

const API_URL = import.meta.env.SECRET_API_URL;
const screenshotUrl = API_URL + previewImage.url
---
<div class="project-card">
    {screenshotUrl &&
    <div class="project-card-image">
        <a href={`/portfolio/${slug}`}>
            <Image
                src={screenshotUrl}
                inferSize={true}
                class="object-cover w-full h-full rounded-lg border border-primary dark:border-secondary"
                alt={preview} />
        </a>
    </div>}
    <div class="mt-8">
        <h3 class="text-primary dark:text-cyan">
            <a href={`/portfolio/${slug}`}>
                {icon != '' &&
                <NerdFontIcon icon={icon} class="text-primary dark:text-cyan mr-2" />
                }
                {title}
            </a>
        </h3>
        <p class="text-xl py-8.5 leading-[150%]">{truncateWords(preview, 30)}</p>

    </div>

    <a href={`/portfolio/${slug}`} class="learn-more annotateCircle">Learn More</a>
</div>
<style>
@reference "#main.css";
.project-card {
    @apply relative flex flex-col;
}
.project-card-image {
    @apply h-68.5 w-full relative mb-3;
    @apply rounded-lg;

    &:after {
        content: ' ';
        @apply absolute w-full h-full top-3 left-3 -z-10 pointer-events-none;
        @apply transition-colors;
        @apply bg-primary;
        @apply rounded-lg;

        @variant dark {
            @apply bg-secondary;
        }
    }
}

@variant dark {
    .project-card-image {
        &:after {
            @apply bg-secondary!;
        }
    }
}

.learn-more {
    @apply text-secondary justify-self-end relative font-bold mt-auto w-fit;

    &:after {
        content: ' ';
        @apply absolute w-full h-0.5 transition-all;
        @apply left-0 bottom-0;
        @apply bg-secondary;
    }

    @variant dark { 
        &:after {
            /* @apply bg-cyan; */
        }
    }
}
</style>
