---
const { name, placeholder = "", required = false, class:className } = Astro.props
---

<div class={`form-input ${className}`}>
    <textarea name={name} class="peer" id={name} required={required}>{placeholder != '' && placeholder}</textarea>
    <label for={name}>
        <slot name="label">Message</slot>
    </label>
</div>

<style>
@reference '@css/main.css';
label {
    @apply text-lg font-bold;
    @apply text-darker-50;
}

textarea {
    @apply pt-4;
    @apply text-cyan;
    @apply text-lg;
}
</style>
