---
const { url:href = "#", target, class:className  } = Astro.props
---

<a class=`${className}` {href} {target}>
    <slot>Button Text</slot>
</a>

<style>
@reference '@css/main.css';

a {
    @apply relative flex flex-row items-center flex-0;
    @apply px-8 py-4 text-center text-darker font-bold transition-all;
    @apply border-2 rounded-md;
    @apply min-w-35 max-w-min w-full;
    @apply no-underline;
    @apply overflow-hidden;

    &:after {
        @apply absolute bottom-0 left-0 w-full h-full transition-all translate-y-full;
        @apply -z-20;
        transform-origin: bottom center;
        content: ' ';
    }


    &:hover {
        @apply rounded-lg;

        &:after {
            @apply translate-y-0;
        }
    }

    &.default {
        @apply text-darker;

        &:hover {
            @apply border-transparent text-light bg-darker;
        }
    }

    &.green {
        @apply text-green;

        &:after {
            @apply bg-green;
        }

        &:hover {
            @apply text-darker;
        }
    }

    &.cyan {
        @apply text-cyan;

        &:after {
        @apply bg-cyan;
        }

        &:hover {
        @apply text-darker bg-cyan;
        }
    }

    &.pink {
        @apply text-pink;

        &:after {
        @apply bg-pink;
        }

        &:hover {
        @apply text-darker bg-pink;
        }
    }

    &.purple {
        @apply text-purple;

        &:after {
        @apply bg-purple;
        }

        &:hover {
        @apply text-darker bg-purple;
        }
    }

    &.yellow {
        @apply text-yellow;

        &:after {
        @apply bg-yellow;
        }

        &:hover {
        @apply text-darker bg-yellow;
        }
    }
}
</style>
