---
import { blogDate } from '@js/helpers'
import { truncateWords } from '@shahid19/stringjs'

import NerdFontIcon from '@components/NerdFontIcon.astro'

const { data } = Astro.props
const { icon, title, description, href } = data
---

<div class="service-card">
    <div class="service-card-text pb-11 min-h-75">
        <h3 class="text-primary dark:text-cyan">
            <NerdFontIcon icon={icon} class="text-primary dark:text-cyan mr-2" />
            {title}
        </h3>
        <p class="description pt-8.5 leading-[150%]">{description}</p>
    </div>

    <a href={href} class="learn-more">Learn More</a>
</div>

<style>
    @reference "../../css/main.css";

    .service-card {
        @apply relative w-10/12 md:w-full flex flex-col items-start justify-center;
        @apply border border-primary dark:border-secondary;
        @apply bg-white dark:bg-darker-900;
        @apply p-6.5;
        @apply rounded-lg;

        .service-card-text {
            @apply z-30;
        }

        &:after {
            content: ' ';
            @apply absolute w-full h-full top-3 left-3 -z-10 pointer-events-none;
            @apply transition-colors;
            @apply bg-primary;
            @apply rounded-lg;
        }

        @variant dark {
            &:after {
                @apply bg-secondary;
            }
        }
    }

    .learn-more {
        @apply text-secondary dark:text-cyan justify-self-end relative font-bold;

        &:after {
            content: ' ';
            @apply absolute w-full h-0.5 transition-all;
            @apply left-0 bottom-0;
            @apply bg-secondary;
        }

        @variant dark { 
            &:after {
                @apply bg-cyan;
            }
        }
    }
</style>
