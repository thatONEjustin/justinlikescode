---
import MenuItem from "@components/menu/MenuItem.astro";

type MenuItem = {
  label: string,
  href: string,
  icon: string,
  scrollTo?: string
}

const menu: MenuItem[] = [
    {
        label: 'home',
        href: '/',
        icon: 'nf-custom-home',
    },
    {
        label: 'about',
        href: '/about-me',
        icon: 'nf-oct-person_fill',
    },
    {
        label: 'portfolio',
        href: '/portfolio',
        icon: 'nf-dev-terminal'
    },
    {
        label: 'contact',
        href: '/contact',
        icon: 'nf-oct-mail',
    }
]
---

<!--
    TODO: convert to React component possibly
    BUG: for some reason casting button as HTMLAnchorElement still throws error
    BUG: there's a rendering/hydration issue with the spacing
    on production.

-->
<script>
function init () {
    const items = document.querySelectorAll(".menu-item");

    for(var button of items) {
        const button_path = new URL(button.href).pathname 
        const window_path = window.location.pathname

        if(button_path == window_path) {
            button.classList.add('active')
        } else if(button_path != '/' && window_path != '/' && window_path.includes(button_path)) {
            button.classList.add('active')
        } else {
            button.classList.remove('active')
        }
    }
}
document.addEventListener("astro:page-load", init);
</script>

<ul class="flex flex-row items-start py-4 md:py-0">
    {menu.map((item: any) => 
        <MenuItem {item} />
    )}
  
    <!-- <li>
        <ToggleMode />
    </li> -->
</ul>
