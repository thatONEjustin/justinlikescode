---
export const prerender = true
import { getCollection } from 'astro:content'

import BlogCard from './BlogCard.astro'

const blog_posts = (await getCollection('blog'))

const latestBlogPosts = blog_posts
    .sort((a, b) => (a.data.publishedAt < b.data.publishedAt) ? 1 : -1)
    .slice(0,3)
---

<section class="blog-posts">
    <div class="blog-posts-container">
        {latestBlogPosts.map((post: any) => <BlogCard data={post.data} />)}
    </div>
</section>

<style>
@reference "#main.css";

.blog-posts {
    @apply py-10;
    @apply relative overflow-hidden;

    .blog-posts-container {
        @apply relative mx-auto grid grid-cols-1 z-30;
        @apply px-8;

        @variant lg {
            @apply grid-cols-3 gap-x-8;
        }

        @variant xl {
            @apply container px-0;
        }
    }

    &:before {
        @apply absolute w-full h-full top-0 left-0 transition-all ease-linear;
        @apply pointer-events-none;
        @apply opacity-30;

        content: ' ';
        background: var(--color-black);
        background: radial-gradient(circle,var(--color-darker-600),var(--color-black));

        @apply z-10;
    }
}
</style>
