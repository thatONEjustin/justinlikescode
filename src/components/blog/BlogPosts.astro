---
export const prerender = true
import { getCollection } from 'astro:content'

import BlogCard from './BlogCard.astro'

const blog_posts = (await getCollection('blog'))

const sorted = blog_posts.sort((a, b) => {
    // console.log(`a: ${a.data.publishedAt}`, `b: ${b.data.publishedAt}`)
    // return 0
    if(a.data.publishedAt < b.data.publishedAt) {
        return 1
    }

    return -1
}).slice(0,3)
---

<section class="blog-posts">
    <div class="blog-posts-container">
        {sorted.map((post: any) =>
            <BlogCard data={post.data} />
        )}
    </div>
</section>

<style>
@reference '@css/main.css';

.blog-posts {
    @apply py-10;
    @apply relative overflow-hidden;

    .blog-posts-container {
        @apply relative container mx-auto grid grid-cols-1 z-30;
        @apply px-4;

        @variant lg {
            @apply grid-cols-3 gap-x-8;
            @apply px-unset;
        }
    }

    &:before {
        @apply absolute w-full h-full top-0 left-0 transition-all ease-linear;
        @apply pointer-events-none;
        @apply opacity-30;

        content: ' ';
        background: var(--color-black);
        background: radial-gradient(circle,var(--color-darker-600),var(--color-black));

        @apply z-10;
    }

    /* &:after {
        @apply absolute w-full h-full top-0 left-0 transition-all ease-linear;
        @apply opacity-15;
        @apply hidden;
        content: ' ';

        @apply z-20;

        background-size: cover;
        background-image: url('../img/cosmic.jpg');
} */
}
</style>
