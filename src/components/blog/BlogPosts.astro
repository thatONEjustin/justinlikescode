---
export const prerender = true
import { getCollection } from 'astro:content'

// import BlogCard from './BlogCard.astro'
import RecentBlogPost from './RecentBlogPost.astro'

const blog_posts = await getCollection('blog')



const latestBlogPosts = blog_posts
    .sort((a, b) => (a.data.createdAt < b.data.createdAt) ? 1 : -1)
    .slice(0,3)
---

<section class="blog-posts">
    <div class="blog-posts-container">
        {latestBlogPosts.map((post: any) => <RecentBlogPost data={post.data} />)}
    </div>
</section>

<style>
@reference "#main.css";

.blog-posts {
    @apply py-10;
    @apply relative;

    .blog-posts-container {
        @apply relative mx-auto z-30;
        @apply px-8;

        @variant xl {
            @apply container px-0;
        }
    }
}
</style>
