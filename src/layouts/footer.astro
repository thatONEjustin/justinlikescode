---
import moment from "moment";
import NerdFontIcon from '@components/NerdFontIcon.astro'

const techStacks = [
    {
        tagline: "built from",
        url: "https://astro.build/",
        label: "astro",
        icon: "nf-custom-astro",
        text_color: "dark:text-pink text-secondary"
    },
    {
        tagline: "styled with",
        url: "https://tailwindcss.com/",
        label: "tailwindcss",
        icon: "nf-md-tailwind",
        text_color: "text-primary dark:text-cyan"
    },
    {
        tagline: "powered by",
        url: "https://strapi.io/",
        label: "strapi",
        icon: "nf-md-cloud_tags",
        text_color: "text-purple-700 dark:text-cyan"
    },
]
---
<footer class="bg-lightGray dark:bg-darker-800 mt-8 lg:mt-0 relative lg:fixed lg:top-full lg:-translate-y-full w-full py-2 lg:py-0">
    <div class="relative w-full mx-auto flex flex-row items-center justify-between container">
        <ul class="flex flex-col md:flex-row py-1">
            {techStacks.map((technology: any) => (
            <li class="mr-2 last:mr-0">
                {technology.tagline != "" && (
                <span class="font-normal text-black dark:text-yellow">{technology.tagline}</span>
                )}
                <a href={technology.url} target="_blank" class=`${technology.text_color} font-semibold no-underline`>
                    {technology.icon && <NerdFontIcon icon={technology.icon} class=`${technology.text_color} font-semibold no-underline ml-1 mr-1` />}
                    {technology.label}
                </a>
            </li>
            ))}
        </ul>
        <div class="copyright">
            <p class="font-semibold text-black dark:text-darker-50 text-sm italic"><span class="font-normal">copyright</span> {moment().year()}</p>
        </div>
    </div>
</footer>
