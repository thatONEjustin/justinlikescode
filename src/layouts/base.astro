---
import { ClientRouter } from 'astro:transitions';
import { Font } from "astro:assets";
import favicon from '@images/favicon.ico';

import "@css/main.css";

import Header from "@layouts/header.astro";
import Main from "@layouts/main.astro";
import Footer from "@layouts/footer.astro";

const { siteTitle = 'justin, a dev' } = Astro.props
---
<script is:inline>
  function applyTheme() {
    localStorage.theme === "light"
      ? document.documentElement.classList.remove("dark")
      : document.documentElement.classList.add("dark")
  }

  // BUG: this still causes page flash, albeit it's faster now
  document.addEventListener("astro:after-swap", applyTheme);
  applyTheme();
</script>

<script is:inline data-astro-rerun type="module">
    import { annotate } from "https://unpkg.com/rough-notation?module"

    function processAnchors(anchorArray, anchorOptions) {
        anchorArray.forEach((anchor) => {
            const annotation = annotate(anchor, anchorOptions)

            anchor.addEventListener('mouseover', _event => {
                annotation.show()
            })

            anchor.addEventListener('mouseout', _event => {
                annotation.hide()
            })
        })
    }

    const annotateCircleAnchors = document.querySelectorAll('.annotateCircle')
    const annotateUnderlineAnchors = document.querySelectorAll('.annotateUnderline')

    processAnchors(annotateUnderlineAnchors, { type: 'underline' })
    processAnchors(annotateCircleAnchors, { type: 'circle' })
    /*
    document.addEventListener('astro:page-load', function () {
        const annotateCircleAnchors = document.querySelectorAll('.annotateCircle')
        const annotateUnderlineAnchors = document.querySelectorAll('.annotateUnderline')

        processAnchors(annotateUnderlineAnchors, { type: 'underline' })
        processAnchors(annotateCircleAnchors, { type: 'circle' })
    }) */
</script>
<html lang="en" data-theme="light">
    <head>
        <meta charset="utf-8" />

        <link rel="icon" type="image/svg+xml" href={favicon} />

        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />

        <title>{siteTitle}</title>

        <Font cssVariable="--font-roboto-slab" />

        <ClientRouter />
    </head>
    <body>
        <span id="top"></span>
        <Header transition:persist />
        <!-- <Main transition:animate="slide"> -->
        <!--     <slot /> -->
        <!-- </Main> -->
        <main transition:animate="slide">
            <slot />
        </main>
        <Footer />
    </body>
</html>
