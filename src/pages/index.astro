---
import { Image } from "astro:assets"

import resume from "/justin-paelmo-resume.pdf"
import me from "@images/me.jpeg"

import BaseLayout from "@layouts/base.astro";

import PillButton from "@components/PillButton.astro";
import NerdFontIcon from "@components/NerdFontIcon.astro";

import BlogPosts from "@components/blog/BlogPosts.astro";
import SocialMediaList from "@components/SocialMediaList.astro";
---
<BaseLayout>
    <section class="home-hero">
        <div class="home-hero-container">

            <div class="portrait">
                <Image
                    src={me}
                    alt="Hi! I'm Justin Paelmo!"
                    class="portrait-image"
                    />
            </div>

            <div class="intro">
                <h2>Hi, I'm Justin</h2>
                <p>I’m a big enthusiast (aka a big nerd) about web development, productive tooling, Continuous Integration/Development, and server administration.</p>

                <p>I’m committed to using 17 years of professional experience in these areas to helping businesses do what they love, and not worry about today’s technology.</p>

                <PillButton class="flex flex-row text-2xl justify-center items-center mt-8 mx-auto lg:mx-unset" url={resume} target="_blank">
                    Learn More
                </PillButton>

                <!-- <a href="https://archlinux.org" target="_blank" class="archlinux hidden lg:block"> 
                    i use <NerdFontIcon icon="nf-md-arch" class="text-archlinux mr-px!" /><span class="relative -left-1.5 text-archlinux">rch</span>btw.
                </a> -->
            </div>

        </div>
    </section>

    <BlogPosts />

    <section id="social" class="bg-darker-900 py-8">
        <div class="justin-container flex flex-col items-center justify-center">
            <h2 class="text-darker-50">social media</h2>
            <SocialMediaList />
        </div>
    </section>
</BaseLayout>

<style>
@reference "#main.css";

.home-hero {
    @apply grid-bg border-b-2 border-b-primary dark:border-b-secondary;

    @apply bg-white;

    @variant dark {
        @apply bg-darker-900;
    }
}

.home-hero-container {
    @apply w-full
        h-full
        relative
        flex
        flex-col
        z-50
        items-center
        mx-auto;

    @variant lg {
        @apply w-full
            flex-row;
    }

    @variant xl {
        @apply container px-0;
    }
}

.intro {
    @apply w-full px-14;

    @variant lg {
        @apply w-1/2;
    }

    > h2 {
        @apply text-black text-[48px];

        @variant dark {
            @apply text-secondary;
        }

        @variant xl {
            @apply text-[80px];
        }
    }

    > p {
        @apply text-black text-[20px] leading-relaxed;

        @variant dark {
            @apply text-darker-300;
        }

        @variant xl {
            @apply text-[40px];
        }
    }
}

.portrait {
    @apply w-1/2
        flex
        flex-col
        items-center;

    /* @variant md { */
    /*     @apply w-1/3; */
    /* } */
    /**/
    /* @variant lg { */
    /*     @apply w-4/10 */
    /*         mx-auto */
    /*         mt-0; */
    /* } */
}

.portrait-image {
    @apply z-40 mx-auto w-full h-auto;
    @apply mb-8;

    @variant lg {
        @apply mx-unset mb-0;
    }
} 

.archlinux {
    @apply text-dark-600 
        mt-12
        text-sm
        leading-relaxed
        opacity-60
        w-fit;

    @variant hover {
        @apply text-archlinux
            opacity-100;
    }
}
</style>
