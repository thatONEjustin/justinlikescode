---
import { Image } from "astro:assets";

import resume from "/justin-paelmo-resume.pdf";
import me from "../assets/img/me.jpeg";

import BaseLayout from "@layouts/base.astro";

import PillButton from "@components/PillButton.astro";

import Services from "@components/services/Services.astro";
import SectionHeader from "@components/SectionHeader.astro";
import BlogPosts from "@components/blog/BlogPosts.astro";
import SocialMediaList from "@components/SocialMediaList.astro";

const servicesData = [
    {
        title: "Web Development",
        description: "I’ve built websites for over 17 years! I’ve handled everything from eCommerce to blogging to credit unions and more. I have experience in a wide array of web technologies as a full stack developer.",
        href: "/pricing",
        icon: "nf-md-web_check"
    },
    {
        title: "IT/Networking",
        description: "Need help managing your local network? Having trouble understanding what hardware to purchase and why? I regularly keep my finger on the pulse on the latest technology trends and am here to help!",
        href: "/pricing",
        icon: "nf-fa-network_wired"
    },
    {
        title: "Custom Solutions",
        description: "Need something tech related that does not fall under the other two categories? Maybe you’re looking to learn more about the industries I’ve worked with/in. Let’s have a discussion I’m always glad to help people get the most out of technology!",
        href: "/pricing",
        icon: "nf-md-folder_question"
    }
]
---
<BaseLayout>
    <section class="home-hero">
        <div class="home-hero-container">
            <div class="portrait">
                <Image src={me} alt="Hi! I'm Justin Paelmo!" class="portrait-image"/>
            </div>

            <div class="intro">
                <h2>Hi, I'm Justin</h2>
                <p>I’m a big enthusiast (aka a big nerd) about web development, productive tooling, Continuous Integration/Development, and server administration.</p>

                <p>I’m committed to using 17 years of professional experience in these areas to helping businesses do what they love, and not worry about today’s technology.</p>

                <PillButton class="flex flex-row text-2xl justify-center items-center mt-8 mx-auto lg:mx-unset" url={resume} target="_blank">
                    Learn More
                </PillButton>
            </div>
        </div>
    </section>

    <section id="resume" class="bg-primary dark:bg-cyan-900 py-14">
        <SectionHeader class="mb-9">
            <h2 class="text-white dark:text-cyan pb-4!" slot="title">Need My Resume?</h2>
        </SectionHeader>
        <PillButton href={resume} class="inverse text-3xl mx-auto border-white after:bg-white! hover:text-primary dark:hover:text-cyan-900" target="_blank">
            Here It Is!
        </PillButton>
    </section>

    <section id="services" class="flex flex-col items-center">
        <SectionHeader>
            <h2 slot="title">Services</h2>
            <p slot="description">I'm a big enthusiast (aka a big nerd) about web development, productive tooling, Continuous Integration/Development, and server administration.</p>
        </SectionHeader>

        <div class="service-cards container mx-auto py-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 md:gap-x-10 xl:gap-x-30">
            {servicesData.map((serviceData: any) => <ServiceCard data={serviceData} />)}
        <div>
    <section>

    <section id="social" class="bg-primary dark:bg-darker-900 py-8">
        <SectionHeader class="mb-9">
            <h2 class="text-white dark:text-cyan pb-4!" slot="title">Social Media</h2>
        </SectionHeader>
        <div class="justin-container flex flex-col items-center justify-center">
            <SocialMediaList />
        </div>
    </section>

    <BlogPosts />

</BaseLayout>

<style>
@reference "#main.css";

.home-hero {
    @apply grid-bg border-b-2 border-b-primary dark:border-b-secondary;

    @apply bg-white;

    @variant dark {
        @apply bg-darker-900;
    }
}

.home-hero-container {
    @apply w-full
        h-full
        relative
        flex
        flex-col
        z-50
        items-center
        mx-auto;

    @variant lg {
        @apply w-full
            flex-row;
    }

    @variant xl {
        @apply container px-0;
    }
}

.intro {
    @apply w-full px-14;

    @variant lg {
        @apply w-1/2;
    }

    > h2 {
        @apply text-black text-[48px];

        @variant dark {
            @apply text-secondary;
        }

        @variant xl {
            @apply text-[80px];
        }
    }

    > p {
        @apply text-black text-[20px] leading-relaxed;

        @variant dark {
            @apply text-darker-300;
        }

        @variant xl {
            @apply text-[40px];
        }
    }
}

.portrait {
    @apply w-1/2
        flex
        flex-col
        items-center;

    /* @variant md { */
    /*     @apply w-1/3; */
    /* } */
    /**/
    /* @variant lg { */
    /*     @apply w-4/10 */
    /*         mx-auto */
    /*         mt-0; */
    /* } */
}

.portrait-image {
    @apply z-40 mx-auto w-full h-auto;
    @apply mb-8;

    @variant lg {
        @apply mx-unset mb-0;
    }
} 

.archlinux {
    @apply text-dark-600 
        mt-12
        text-sm
        leading-relaxed
        opacity-60
        w-fit;

    @variant hover {
        @apply text-archlinux
            opacity-100;
    }
}
</style>
