---
export const prerender = true

import { getCollection } from 'astro:content';
import { capitalizeString } from "@js/helpers";

import BaseLayout from "@layouts/base.astro";
import ProjectCard from "@components/projects/ProjectCard.astro";
import NerdFontIcon from "@components/NerdFontIcon.astro";

const projects = await getCollection('projects');


let sortedByCategory: any = []

projects.map((project: any) => {
    if (sortedByCategory.find((categoryItem: any) => {
        if (categoryItem.id === project.data.category) {
            categoryItem.count++
            categoryItem.projects = [...categoryItem.projects, project]
            return true
        } else {
            return false
        }
    })) {
        // technically this *is* what we did
    } else {
        sortedByCategory.push({
            id: project.data.category,
            count: 1,
            projects: [project]
        })
    }
})

const sortedByCount = await sortedByCategory.sort((a: any, b: any) => (a.count > b.count) ? -1 : 1)

const categoryIcon = (categoryId: string = ''): string => {
    let icon = ""
    switch (categoryId) {
        case "ecommerce":
            icon = "nf-fa-cart_shopping"
        break;
        case "b2b":
            icon = "nf-md-handshake"
        break;
        case "medical":
            icon = "nf-fa-laptop_medical"
        break;
        case "government":
            icon = "nf-cod-law"
        break;
        case "banking/credit":
            icon = "nf-fa-bank"
        break;
        default:
            icon = "nf-md-developer_board"
    }

    return icon
}


const categoryTitle = (categoryId: string): string => {
    if(categoryId.includes('2')) return categoryId.split('2').map(word => capitalizeString(word)).join('2')
    if(!categoryId.includes('/')) return capitalizeString(categoryId)
    return categoryId.split('/').map(word => capitalizeString(word)).join('/')
}

function logProject(project: any) {
    console.log('project', project)
}
---

<BaseLayout>
    <section class="container mx-auto">
        {sortedByCount.map(({id, projects}) => 
        <div class="mb-24 first-of-type:mt-12">
            <h2 class="text-4xl"><NerdFontIcon icon={categoryIcon(id)} /> {categoryTitle(id)}</h2>

            <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-x-[60px] mt-8">
                {projects.map((project) => <ProjectCard project={project} icon={categoryIcon(id)} />)}
            </div>
        </div>
        )}
    </section>
</BaseLayout>

<style>
@reference "#main.css";

.project-cards {
    @apply mx-auto grid grid-cols-1 auto-rows-auto overflow-hidden relative;

    &:before {
        @apply absolute w-full h-screen top-0 left-0 transition-all ease-linear;
        @apply pointer-events-none;
        @apply opacity-30;

        content: ' ';
        background: var(--color-black);
        background: radial-gradient(circle,var(--color-darker-600),var(--color-black));

        @apply z-10;
    }
}
</style>
