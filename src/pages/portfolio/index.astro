---
export const prerender = true

import BaseLayout from "@layouts/base.astro";
import SectionHeader from "@components/SectionHeader.astro";
import ProjectCard from "@components/projects/ProjectCard.astro";
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const newestProjectsFirst = projects.sort((a, b) => (a.data.updatedAt < b.data.updatedAt) ? 1 : -1)
---

<BaseLayout>
    <SectionHeader class="mb-9">
        <h2 class="text-primary dark:text-cyan py-4!" slot="title">Previous Work</h2>
    </SectionHeader>
    <section class="project-cards">
        {newestProjectsFirst.map((project: any) => <ProjectCard data={project.data} />)}
    </section>
</BaseLayout>

<style>
@reference "#main.css";

.project-cards {
    @apply mx-auto grid grid-cols-1 auto-rows-auto overflow-hidden relative;

    &:before {
        @apply absolute w-full h-screen top-0 left-0 transition-all ease-linear;
        @apply pointer-events-none;
        @apply opacity-30;

        content: ' ';
        background: var(--color-black);
        background: radial-gradient(circle,var(--color-darker-600),var(--color-black));

        @apply z-10;
    }
}
</style>
