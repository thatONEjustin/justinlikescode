---
export const prerender = true

import { getCollection } from 'astro:content'
import { marked } from 'marked'

import BaseLayout from "@layouts/base.astro"
import PillButton from '@components/PillButton.astro'
import NerdFontIcon from '@components/NerdFontIcon.astro'
import Slider from '@components/slider/Slider.astro'
import Slide from '@components/slider/Slide.astro'
import { Image } from 'astro:assets'

export async function getStaticPaths() {
    const portfolioProjects = await getCollection('projects')

    const staticPaths = portfolioProjects.map(({...project}: any) => {
        return {
            params: { slug: project.data.slug },
            props:{...project.data}
        }
    })

    return staticPaths
}


const { title, show_url = true, url, screenshots, description, techStack } = Astro.props


// const widestScreenshots = screenshots.sort((a: any, b: any) => (a.width < b.width) ? 1 : -1)

    /*
const swiperOptions = { 
    effect: 'cards',
    cardsEffect: {
        centeredSlides: true,
    },
    autoHeight: false,
}
*/

const swiperThumbs = {
    autoHeight: false,
    slidesPerView: 3,
    navigation: false,
}

const swiperOptions = {
    autoHeight: false,
    thumbs: {
        swiper: '.thumbnails'
    }
}



const API_URL = import.meta.env.SECRET_API_URL;

function getTechStackIcon(technology:string): string {
    return (() => {
        switch (technology.toLowerCase().replaceAll(' ', '').replaceAll('.', '')) {
            case "tailwindcss":
                return "nf-dev-tailwindcss"
            case "wordpress":
                return "nf-dev-wordpress"
            case "woocommerce":
                return  "nf-dev-woocommerce"
            case "sass":
                return  "nf-md-sass"
            case "react":
                return  "nf-md-react"
            case "astro":
                return  "nf-md-astro"
            case "alpinejs":
                return  "nf-dev-alpinejs"
            case "jquery":
                return  "nf-dev-jquery"
            case "vuejs":
                return  "nf-seti-vue"
            case "nextjs":
                return  "nf-dev-nextjs"
            case "bootstrap":
                return  "nf-dev-bootstrap"
            case "laravel":
                return  "nf-dev-laravel"
            case "angular":
                return  "nf-dev-angular"
            case "iconicframework":
                return  "nf-dev-ionic"
            case "craftcms":
                return  "nf-md-alpha_c_circle"
            case "shopify":
            case "craftcommerce":
                return  "nf-md-alpha_s_circle"
            default:
                return "nf-dev-terminal"
        }
    })()
}
---

<BaseLayout>
    <section class="container mx-auto py-8 lg:py-16">
        <h2 class="text-primary dark:text-cyan">{title}</h2>

        <div class="flex flex-row">
            <div class="flex flex-col w-full xl:w-2/3">
                <div class="main-slide">
                    <Slider class="overflow-hidden rounded-lg main-slideshow" swiperOptions={swiperOptions}>
                        <Fragment slot="slides">
                            {screenshots.map((screenshot: any) => 
                            <Slide class="rounded-lg">
                                <Image
                                    src={API_URL + screenshot.url}
                                    inferSize={true}
                                    alt={screenshot.alternativeText ? screenshot.alternativeText : title}
                                    class="mx-auto object-contain rounded-lg "
                                    />
                            </Slide>
                            )}
                        </Fragment>
                    </Slider>
                </div>

                <div class="thumbnail-controls mt-8">
                    <Slider class="overflow-hidden thumbnails" arrows={false} swiperOptions={swiperThumbs}>
                        <Fragment slot="slides">
                            {screenshots.map((screenshot: any) => 
                            <Slide class="rounded-lg max-h-30 max-w-fit w-full">
                                <Image
                                    src={API_URL + screenshot.url}
                                    width="221"
                                    height="120"
                                    alt={screenshot.alternativeText ? screenshot.alternativeText : title}
                                    class="mx-auto object-cover rounded-lg"
                                    />
                            </Slide>
                            )}
                        </Fragment>
                    </Slider>
                </div>
            </div>
        </div>

    </section>
</BaseLayout>

<style>
@reference "#main.css";

.main-slide {
    @apply lg:px-unset max-h-137.5 w-full;
    @apply relative;

    &:after {
        content: ' ';
        @apply absolute w-full h-full top-3 left-3 -z-10 pointer-events-none;
        @apply transition-colors;
        @apply bg-primary;
        @apply rounded-lg;
    }
}
</style>
